# Server (apps/server) — copy to .env and adjust.
# Required by packages/env (validated at boot; server won't start without these).

# Where the SQLite database lives, relative to apps/server.
# file:../../local.db = repo root (matches drizzle config).
DATABASE_URL=file:../../local.db

# The web app's origin (CORS allow-list).
CORS_ORIGIN=http://localhost:3300

# Hono dev server port. 3301 avoids the common 3000/3001 collisions.
PORT=3301

# Optional — keyword watchlist for the digest CLI (comma-separated, case-insensitive).
# ⭐-marks matching events in `pnpm --filter server digest` output.
# DIGEST_KEYWORDS=tattoo,jazz,fado,rock

# --- Auth (packages/auth) -------------------------------------------------
# A second database, separate from the events data: the read-only Turso token
# that the browser carries can read every row it can reach, so user emails and
# session rows must never live in the events DB.
# `file:` locally; `libsql://<db>-<org>.turso.io` in production.
AUTH_DATABASE_URL=file:../../local-auth.db
# Required when AUTH_DATABASE_URL is a remote Turso database. Read-write.
# AUTH_TURSO_TOKEN=

# Signs session cookies. 32+ chars. Rotating it signs everyone out.
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Public origin of the app. Callback URLs and the trusted-origin list are built
# from it, so it must be exactly what the browser types.
BETTER_AUTH_URL=http://localhost:3300

# Extra trusted origins, comma-separated. Loopback aliases are already added
# outside production; use this for LAN addresses and Vercel previews.
# AUTH_TRUSTED_ORIGINS=https://findleiria-git-branch-0x81d1.vercel.app

# Google OAuth client — Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI must be <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
