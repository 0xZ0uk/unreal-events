# Web (apps/web) — copy to .env and adjust.

# Remote Turso (libSQL) database the SPA reads directly from the browser over
# SQL-over-HTTP (`@libsql/client/web`). No Hono server involved.
VITE_TURSO_URL=https://<org>-<db>.turso.io

# Optional read-only auth token. Inlined into the bundle by design — the data
# is public events and the token is read-only scoped.
VITE_TURSO_AUTH_TOKEN=

# Prerender (build step) — where the event pages read the corpus from. On Vercel
# these come from the project env; locally they fall back to the two above.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cookieless analytics. Both must be set to load anything; leave empty and the
# app ships no third-party script.
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=